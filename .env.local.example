NEXT_PUBLIC_SANITY_PROJECT_ID=your_new_sanity_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Server-side only — never prefix with NEXT_PUBLIC_
SANITY_API_READ_TOKEN=your_read_token_here

# Used only by scripts/migrate-sanity.mjs — Editor role, never read at runtime
SANITY_API_WRITE_TOKEN=your_write_token_here

# Shared secret checked by app/api/revalidate/route.ts against the Sanity webhook
SANITY_REVALIDATE_SECRET=your_revalidate_secret_here
